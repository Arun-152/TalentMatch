# ─── Python / Django ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Virtual environments
backend/venv/
venv/
.venv/
env/
ENV/

# Django artefacts
*.sqlite3
*.sqlite3-journal
backend/media/
backend/staticfiles/
backend/static_root/

# Collected static (only if you run collectstatic)
/static/

# ─── Node / React / Vite ─────────────────────────────────────────
node_modules/
frontend/node_modules/

# Production build output
frontend/dist/
frontend/.vite/

# ─── Environment & Secrets ───────────────────────────────────────
