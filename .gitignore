pip-delete-this-directory.txt

# ─── Coverage & test artefacts ───────────────────────────────────
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── NOT ignored (explicitly kept) ───────────────────────────────
# Django migration files are source code — do NOT add migrations/ here.
# Frontend source files are source code — do NOT add src/ here.
